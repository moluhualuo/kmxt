KMXT_HOST=127.0.0.1
KMXT_PORT=8080
KMXT_STORAGE_DRIVER=json
KMXT_DATA_FILE=./data/kmxt.json
KMXT_SECRET_FILE=./data/secret.key
KMXT_PUBLIC_DIRECTORY=./public
KMXT_CORS_ORIGIN=
KMXT_ADMIN_SESSION_TTL_SECONDS=28800
KMXT_CLIENT_SESSION_TTL_SECONDS=1800
KMXT_HEARTBEAT_SECONDS=300
KMXT_CLOCK_SKEW_SECONDS=300
KMXT_PUBLIC_BASE_URL=http://127.0.0.1:8080
KMXT_PROTOCOL_VERSION=1
KMXT_MODEL_LEASE_TTL_SECONDS=600
KMXT_MODEL_LEASE_MAX_TTL_SECONDS=900
KMXT_MODEL_ARTIFACT_MAX_BYTES=2147483648
KMXT_TRUSTED_PROXY_CIDRS=

# Production MySQL 8 (password and CA are mounted read-only files)
KMXT_MYSQL_HOST=127.0.0.1
KMXT_MYSQL_PORT=3306
KMXT_MYSQL_USER=kmxt
KMXT_MYSQL_DATABASE=kamxt1
KMXT_MYSQL_PASSWORD_FILE=/run/secrets/kmxt_mysql_password
KMXT_MYSQL_TLS_CA_FILE=/run/secrets/kmxt_mysql_ca.pem
KMXT_MYSQL_POOL_LIMIT=10
KMXT_MYSQL_POOL_QUEUE_LIMIT=100
KMXT_MYSQL_OPERATION_TIMEOUT_MS=8000
KMXT_SHUTDOWN_TIMEOUT_MS=10000
KMXT_MYSQL_AUTO_MIGRATE=false

# Dedicated Redis 7; never point this at the new-api Redis instance.
KMXT_REDIS_URL=
KMXT_REDIS_PASSWORD_FILE=/run/secrets/kmxt_redis_password
KMXT_REDIS_KEY_PREFIX=kmxt:
